# Environment template for Mantis / Xhihangule
# Copy this file to .env and fill values locally. Do not commit real credentials.

# Core
# NODE_ENV
# PORT
# MONGODB_URI
# JWT_SECRET
# JWT_REFRESH_SECRET

# Public company signup. Production refuses signup and /api/onboarding/start unless this is true.
# The registration page always calls /api/onboarding/start. It does not depend on REACT_APP_SAAS_ONBOARDING_V2.
# ALLOW_PUBLIC_SIGNUP=false

# Free Trial registration does not use Paynow. Landlord and Property Manager always continue to Paynow checkout.
# This flag only applies when an authenticated administrator creates a company outside the public pricing journeys.
# REGISTRATION_PAYMENT_REQUIRED=false

# Enterprise stays on Talk to Sales unless this is true. Do not invent a negotiated Enterprise price.
# ENTERPRISE_DIRECT_CHECKOUT=false

# Incomplete paid registrations can be archived after this many days. Active trials and paid companies are not affected.
# ABANDONED_REGISTRATION_RETENTION_DAYS=7

# Break-glass system administrator. Off unless every condition below is met.
# Never runs when NODE_ENV=production. Creates a missing user only.
# Does not reset a password, reactivate an account, or add roles to an existing user.
# ALLOW_SYSTEM_ADMIN_BOOTSTRAP=false
# SYSTEM_ADMIN_BOOTSTRAP_EMAIL=
# SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=

# Ecosystem master override — development / internal test only. Never enable globally in production.
# ECOSYSTEM_ENABLED=false

# Per-flag overrides. Unset = company.featureFlags, which default to false.
# TENANT_PORTAL_ENABLED
# CONTRACTOR_PORTAL_ENABLED
# PROPERTY_MARKETPLACE_ENABLED
# MAINTENANCE_QUOTES_ENABLED
# ONLINE_PAYMENTS_ENABLED
# MULTICHANNEL_NOTIFICATIONS_ENABLED
# TENANT_REFERENCES_ENABLED
# CONTRACTOR_RATINGS_ENABLED

# Email — uses the existing Mantis email service. Channel is SKIPPED when unconfigured.
# EMAIL_ENABLED
# EMAIL_PROVIDER
# SMTP_HOST
# SMTP_PORT
# SMTP_USER
# SMTP_PASS
# SMTP_FROM

# SMS — official provider only. Disabled by default (SKIPPED).
# SMS_ENABLED
# SMS_PROVIDER

# WhatsApp — official provider APIs only. No unofficial automation.
# WHATSAPP_ENABLED
# WHATSAPP_PROVIDER

# Online rent payments — abstraction only. Does not create Payment or journals.
# RENT_PAYMENT_PROVIDER=stub
# ONLINE_PAYMENTS_ENABLED=false

# Paynow subscription checkout. Set these on the server only. Never expose the integration key to the client.
# Missing credentials make checkout return PAYNOW_NOT_CONFIGURED. They do not mark a payment as paid.
# PAYNOW_MODE=live
# Use PAYNOW_MODE=test with Paynow test integration credentials. Do not leave this unset in production.
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# PUBLIC_BASE_URL=https://www.mantisafrica.com
# PAYNOW_RESULT_URL=https://www.mantisafrica.com/api/paynow/result
# PAYNOW_RETURN_URL=https://www.mantisafrica.com/api/paynow/return
# CLIENT_URL=https://www.mantisafrica.com
# ALLOWED_ORIGINS=https://www.mantisafrica.com,https://mantisafrica.com

# Public client variables only. Never put server secrets in React env.
# REACT_APP_SITE_URL
# REACT_APP_WS_URL
# REACT_APP_SAAS_ONBOARDING_V2

{
  "name": "server",
  "version": "1.0.0",
  "description": "Express backend with MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:worker": "cross-env APP_ROLE=worker node dist/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --watch src src/index.ts",
    "dev:worker": "cross-env APP_ROLE=worker ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --watch src src/worker.ts",
    "dev:prod-env": "cross-env ENV_FILE=.env.production ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --watch src src/index.ts",
    "build": "tsc",
    "start:prod": "cross-env NODE_ENV=production ENV_FILE=.env.production node dist/index.js",
    "start:prod:worker": "cross-env NODE_ENV=production ENV_FILE=.env.production APP_ROLE=worker node dist/worker.js",
    "reconcile:dry": "npm run build && node dist/scripts/reconcile.js --dry-run",
    "reconcile:apply": "npm run build && node dist/scripts/reconcile.js --apply",
    "ledger:maintain": "npm run build && node dist/scripts/ledgerMaintenance.js",
    "ledger:backfill-keys": "npm run build && node dist/scripts/backfillIdempotencyKeys.js",
    "inspections:backfill:dry": "npm run build && node dist/scripts/backfillInspectionCompliance.js --dry-run --no-reminder-spam",
    "inspections:backfill:apply": "npm run build && node dist/scripts/backfillInspectionCompliance.js --apply --no-reminder-spam",
    "companies:workspace-type:dry": "npm run build && node dist/scripts/migrateCompanyWorkspaceType.js",
    "companies:workspace-type:apply": "npm run build && node dist/scripts/migrateCompanyWorkspaceType.js --apply",
    "saas:indexes": "npm run build && node dist/scripts/saasSafeIndexes.js",
    "test": "node -e \"console.error('Server tests run as ts-node scripts. Use npm run test:security-remediation, npm run test:first-adoption, or a test:phase* script. Jest is not the project test runner.'); process.exit(1)\"",
    "test:security-remediation": "ts-node --transpile-only src/scripts/runSecurityRemediationTests.ts",
    "diagnose:payment-references": "ts-node --transpile-only src/scripts/diagnosePaymentReferenceCollisions.ts",
    "test:reporting": "npm run build && node dist/reporting/tests/runReportingTests.js",
    "test:phase2a": "npm run build && node dist/scripts/runPhase2aSafetyTests.js",
    "test:phase2b": "npm run build && node dist/scripts/runPhase2bCompletenessTests.js",
    "test:phase2-hardening": "npm run build && node dist/scripts/runPhase2FinancialHardeningTests.js",
    "test:phase5b": "npm run build && node dist/scripts/runPhase5bAccountingTests.js",
    "test:phase2c": "npm run build && node dist/scripts/runPhase2cAccountingIntegrityTests.js",
    "test:phase2d": "npm run build && node dist/scripts/runPhase2dWritePathLockdownTests.js",
    "test:phase21": "npm run build && node dist/scripts/runPhase21AgentCommissionAndStartupTests.js",
    "test:vat-commission": "npm run build && node dist/scripts/runVatOnCommissionTests.js",
    "test:vat-commission-lifecycle": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runVatOnCommissionLifecycleTests.ts",
    "test:vat-path-consistency": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runVatPathConsistencyTests.ts",
    "test:vat-reversal-idempotency": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runVatReversalIdempotencyTests.ts",
    "test:reversal-journal-idempotency": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runReversalJournalIdempotencyTests.ts",
    "test:reversal-remediation": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runReversalRemediationTests.ts",
    "test:reversal-coverage": "cross-env NODE_ENV=development MONGODB_URI=mongodb://127.0.0.1:27017/mantis_reversal_coverage_test ACCOUNTING_DB_URI=mongodb://127.0.0.1:27017/mantis_reversal_coverage_accounting ts-node --transpile-only src/scripts/runReversalCoverageAndNoticeTests.ts",
    "test:rental-period-lock": "cross-env NODE_ENV=development MONGODB_URI=mongodb://127.0.0.1:27017/mantis_rental_lock_test ACCOUNTING_DB_URI=mongodb://127.0.0.1:27017/mantis_rental_lock_accounting ts-node --transpile-only src/scripts/runRentalPeriodLockTests.ts",
    "test:financial-consistency": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runFinancialConsistencyTests.ts",
    "test:owner-rent-notice": "ts-node --transpile-only src/scripts/runOwnerRentNotificationTests.ts",
    "test:tax-position": "ts-node --transpile-only src/scripts/runTaxPositionTests.ts",
    "test:unified-tax-ledger": "ts-node --transpile-only src/scripts/runUnifiedTaxLedgerTests.ts",
    "test:new-tax-integrity": "ts-node --transpile-only src/scripts/runNewTaxIntegrityTests.ts",
    "test:cosmos-financial-probe": "ts-node --transpile-only src/scripts/runCosmosFinancialProbe.ts",
    "test:cosmos-lock-compatibility": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runCosmosLockCompatibilityTests.ts",
    "test:expense-sync": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runExpenseSyncTests.ts",
    "test:financial-recovery": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runFinancialRecoveryTests.ts",
    "test:paynow-callback": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runPaynowCallbackTests.ts",
    "test:paynow-lifecycle": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runPaynowLifecycleTests.ts",
    "paynow:preflight": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/paynowConfigPreflight.ts",
    "paynow:diagnose": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/diagnosePaynowSession.ts",
    "test:integrity-gaps": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runIntegrityGapTests.ts",
    "test:phase3c": "npm run build && node dist/scripts/runPhase3cDuplicateConsolidationTests.js",
    "test:phase3d": "npm run build && node dist/scripts/runPhase3dLegacyCleanupTests.js",
    "test:phase4": "npm run build && node dist/scripts/runPhase4FinancialIntegrityTests.js",
    "test:phase5": "npm run build && node dist/scripts/runPhase5FinancialTransactionTests.js",
    "test:phase6": "npm run build && node dist/scripts/runPhase6IntroductionLifecycleTests.js",
    "test:phase7": "npm run build && node dist/scripts/runPhase7FinancialIntegrityTests.js",
    "test:phase8": "npm run build && node dist/scripts/runPhase8TaxComplianceTests.js",
    "test:phase81": "npm run build && node dist/scripts/runPhase81TaxComplianceTests.js",
    "test:phase82": "npm run build && node dist/scripts/runPhase82ProductionVerificationTests.js",
    "test:phase83": "npm run build && node dist/scripts/runPhase83FinalSignOffTests.js",
    "test:phase9": "npm run build && node dist/scripts/runPhase9FinancialControlsTests.js",
    "test:individual-accounting-b": "npm run build && node dist/scripts/runIndividualAccountingPhaseBTests.js",
    "test:individual-accounting-c": "npm run build && node dist/scripts/runIndividualAccountingPhaseCTests.js",
    "test:individual-accounting-d": "npm run build && node dist/scripts/runIndividualAccountingPhaseDTests.js",
    "test:individual-accounting-e": "npm run build && node dist/scripts/runIndividualAccountingPhaseETests.js",
    "test:individual-accounting-f": "npm run build && node dist/scripts/runIndividualAccountingPhaseFTests.js",
    "test:individual-accounting-g": "npm run build && node dist/scripts/runIndividualAccountingPhaseGTests.js",
    "test:individual-accounting-h": "npm run build && node dist/scripts/runIndividualAccountingPhaseHTests.js",
    "test:individual-accounting-i": "npm run build && node dist/scripts/runIndividualAccountingPhaseITests.js",
    "test:ecosystem": "ts-node --transpile-only src/scripts/runEcosystemTests.ts",
    "test:first-adoption": "ts-node --transpile-only src/scripts/runFirstAdoptionReadinessTests.ts",
    "test:registration-payment": "cross-env NODE_ENV=development ts-node --transpile-only src/scripts/runRegistrationPaymentTests.ts",
    "test:css-index-declarations": "ts-node --transpile-only src/scripts/runCssAndIndexDeclarationTests.ts",
    "audit:onboarding-index": "ts-node --transpile-only src/scripts/auditOnboardingIdempotencyIndex.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.826.0",
    "@aws-sdk/s3-request-presigner": "3.826.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/puppeteer": "^5.4.7",
    "@types/socket.io": "^3.0.1",
    "archiver": "^6.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^3.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.12",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.11",
    "paynow": "^2.2.2",
    "pdf-lib": "^1.17.1",
    "puppeteer": "24.31.0",
    "save": "^2.9.0",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "jws": "3.2.3",
    "ws": "8.22.0",
    "basic-ftp": "5.3.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^18.15.11",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.3"
  }
}
